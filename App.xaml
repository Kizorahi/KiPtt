<Application x:Class="KiPtt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#8A2BE2" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#9370DB" />
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#121214" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1E1E24" />
        </ResourceDictionary>
    </Application.Resources>
</Application>